# Server Config
PORT=4000
NODE_ENV=development
JWT_SECRET=groww_smart_watchlist_super_secret_key_2026
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=groww_smart_watchlist_refresh_secret_2026

# Database Config (PostgreSQL via Prisma)
# Default for Docker Compose or local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/groww_watchlist?schema=public"

# Redis Config (Cache & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Market Data API Keys (Optional - System auto-falls back to Mock Provider if empty)
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
PRIMARY_MARKET_DATA_PROVIDER=TwelveData

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
