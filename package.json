{
  "name": "groww-smart-watchlist",
  "version": "1.0.0",
  "private": true,
  "description": "Groww Smart Market Watchlist MVP - Full-Stack Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "prisma:setup": "npm --prefix backend run prisma:setup",
    "setup:sqlite": "npm --prefix backend run prisma:setup:sqlite",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
