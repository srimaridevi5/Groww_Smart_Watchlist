{
  "name": "groww-smart-watchlist",
  "version": "1.0.0",
  "private": true,
  "description": "Groww Smart Market Watchlist MVP - Full-Stack Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "postinstall": "npm --prefix backend run prisma:generate",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "prisma:setup": "npm --prefix backend run prisma:setup",
    "setup:sqlite": "npm --prefix backend run prisma:setup:sqlite",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.9.0",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@vercel/node": "^3.0.0",
    "concurrently": "^8.2.2",
    "next": "^14.2.35",
    "prisma": "^5.9.0",
    "typescript": "^5.3.3"
  }
}

