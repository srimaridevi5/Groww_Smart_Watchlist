datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  name         String
  lastVisitAt  DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  watchlists   Watchlist[]
  snapshots    UserVisitSnapshot[]

  @@map("users")
}

model Watchlist {
  id        String              @id @default(uuid())
  userId    String
  name      String
  isDefault Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]
  snapshots UserVisitSnapshot[]

  @@map("watchlists")
}

model WatchlistItem {
  id           String    @id @default(uuid())
  watchlistId  String
  stockSymbol  String
  displayOrder Int       @default(0)
  addedAt      DateTime  @default(now())
  watchlist    Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, stockSymbol])
  @@map("watchlist_items")
}

model StockMaster {
  id               String   @id @default(uuid())
  symbol           String   @unique
  name             String
  exchange         String   @default("NSE")
  sector           String?
  fiftyTwoWeekHigh Float
  fiftyTwoWeekLow  Float
  avgVolume20d     Float
  volatility30d    Float    @default(0.02)
  beta             Float    @default(1.0)
  updatedAt        DateTime @updatedAt

  @@map("stock_masters")
}

model UserVisitSnapshot {
  id               String   @id @default(uuid())
  userId           String
  watchlistId      String
  stockSymbol      String
  price            Float
  volume           Float
  volatility       Float?
  fiftyTwoWeekHigh Float
  fiftyTwoWeekLow  Float
  capturedAt       DateTime @default(now())
  dataTimestamp    DateTime @default(now())
  dataProvider     String   @default("Mock")
  dataConfidence   Float    @default(1.0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([userId, watchlistId, stockSymbol])
  @@map("user_visit_snapshots")
}

model ChangeEvent {
  id             String   @id @default(uuid())
  watchlistId    String
  stockSymbol    String
  previousPrice  Float
  currentPrice   Float
  priceChangePct Float
  changeScore    Float
  severityTier   String   // HIGH_ATTENTION, SIGNIFICANT, NOTEWORTHY, NORMAL
  reasons        String   // JSON string of signals
  detectedAt     DateTime @default(now())

  @@index([watchlistId, stockSymbol, detectedAt])
  @@map("change_events")
}
